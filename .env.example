# Gmail address the contact form sends FROM (usually your own Gmail).
GMAIL_USER=maryamirshad842@gmail.com

# A 16-character Gmail "App Password" — NOT your normal Gmail password.
# See README.md -> "Contact form email setup" for how to generate one.
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Admin panel (/admin) — pick your own username and a strong password.
ADMIN_USERNAME=maryam
ADMIN_PASSWORD=change-this-to-a-strong-password

# Any long random string — used to sign admin login sessions.
# Generate one with: openssl rand -base64 32
ADMIN_JWT_SECRET=replace-with-a-long-random-string

